{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent_er_spec/erd-bundle.schema.json",
  "title": "ER Canvas Bundle",
  "description": "Agent 將 MD / SQL / 設計稿整理後應輸出此結構；可由宿主頁轉為 LAYERS、TABLES、各圖之 canvas/positions/connections 等常數。",
  "type": "object",
  "required": ["meta", "layers", "tables", "diagrams"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string" },
        "locale": { "type": "string", "default": "zh-Hant" },
        "notes": { "type": "string" }
      }
    },
    "constants": {
      "type": "object",
      "description": "表卡寬高（像素）；省略時宿主可使用預設 214 / 172",
      "additionalProperties": false,
      "properties": {
        "cardW": { "type": "number", "minimum": 80 },
        "cardHApprox": { "type": "number", "minimum": 80 }
      }
    },
    "layers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "color", "bg", "border"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "color": { "type": "string" },
          "bg": { "type": "string" },
          "border": { "type": "string" }
        }
      }
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "description": "鍵為資料表邏輯名稱（snake_case）；宿主頁通常對應為 TABLES 物件",
      "additionalProperties": {
        "type": "object",
        "required": ["layer", "status", "cols"],
        "additionalProperties": false,
        "properties": {
          "layer": { "type": "string", "description": "必須為 layers 的 key" },
          "status": {
            "type": "string",
            "enum": ["existing", "new", "future"]
          },
          "section": { "type": "string" },
          "comment": { "type": "string" },
          "cols": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "tag": {
                  "type": "string",
                  "enum": ["PK", "FK", "UQ"],
                  "description": "單欄主鍵 / 外鍵 / 唯一鍵；複合鍵改用 tableConstraints"
                },
                "ref": {
                  "type": "string",
                  "description": "FK 時指向的表名；可寫 `table` 或 `table.col`(col 省略視為對方 PK)"
                },
                "onDelete": {
                  "type": "string",
                  "enum": ["CASCADE", "SET NULL", "RESTRICT", "NO ACTION", "SET DEFAULT"],
                  "description": "僅 FK 時生效"
                },
                "onUpdate": {
                  "type": "string",
                  "enum": ["CASCADE", "SET NULL", "RESTRICT", "NO ACTION", "SET DEFAULT"],
                  "description": "僅 FK 時生效"
                },
                "nullable": { "type": "boolean", "default": true },
                "default": {
                  "type": "string",
                  "description": "原樣字串(如 `CURRENT_TIMESTAMP`、`'pending'`、`0`),agent 不解析語意"
                },
                "enumValues": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "若該欄為列舉型別,列出合法值"
                },
                "note": { "type": "string" }
              }
            }
          },
          "tableConstraints": {
            "type": "array",
            "description": "複合鍵與索引;單欄請優先用 cols[*].tag",
            "items": {
              "type": "object",
              "required": ["type", "cols"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["PK", "UQ", "INDEX", "CHECK"]
                },
                "cols": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" },
                  "description": "CHECK 類型時 cols 可填 [] 或相關欄位名以利索引"
                },
                "name": { "type": "string" },
                "expression": {
                  "type": "string",
                  "description": "CHECK 用,例如 `price >= 0`"
                }
              }
            }
          }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "canvas", "positions", "connections"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "description": "對應 ERDiagram 的 diagId；會寫入 localStorage erd-pos-{id}"
          },
          "label": { "type": "string" },
          "canvas": {
            "type": "object",
            "required": ["w", "h"],
            "additionalProperties": false,
            "properties": {
              "w": { "type": "number", "minimum": 200 },
              "h": { "type": "number", "minimum": 200 }
            }
          },
          "positions": {
            "type": "object",
            "description": "表名 → 卡片中心座標 { cx, cy }（像素）",
            "additionalProperties": {
              "type": "object",
              "required": ["cx", "cy"],
              "additionalProperties": false,
              "properties": {
                "cx": { "type": "number" },
                "cy": { "type": "number" }
              }
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "label"],
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "label": { "type": "string", "description": "線上顯示的 FK 欄位或語意標籤" },
                "cardinality": {
                  "type": "string",
                  "enum": ["1:1", "1:N", "N:1", "N:N", "0:1", "0:N"],
                  "description": "from→to 方向。0:* 代表可選關聯(對應可空 FK);1:* / N:* 代表必有上游。省略時宿主可顯示為一般連線。"
                },
                "isNew": { "type": "boolean" },
                "dashed": { "type": "boolean", "description": "通常代表邏輯關聯而非實體 FK" }
              }
            }
          }
        }
      }
    },
    "dataFlows": {
      "type": "array",
      "description": "選填；對應 DATA_FLOWS（§13 類流程卡）",
      "items": {
        "type": "object",
        "required": ["id", "title", "steps"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tag": { "type": "string" },
          "tagColor": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["actor", "action"],
              "properties": {
                "actor": { "type": "string" },
                "action": { "type": "string" }
              }
            }
          },
          "writes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "designDecisions": {
      "type": "array",
      "description": "選填；對應 DESIGN_DECISIONS 對照卡",
      "items": {
        "type": "object",
        "required": ["title", "old", "v3"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "old": { "type": "string" },
          "v3": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      }
    }
  }
}
